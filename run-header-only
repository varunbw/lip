#!/usr/bin/env bash

# Compile library if it's not made
if [[ ! -f "lib/liblip.a" ]]; then
    echo "Library not found, recompiling..."
    cd lib
    ./compile-lib
    cd ..
fi

# Compile solution code
g++ -g \
    main.cpp -o main \
    -Llib -llip \
    -flto=auto \
    -std=c++23 \
    -fsanitize=address \
    -fsanitize=undefined

if [ $? -ne 0 ]; then
    echo "Compilation failed"
    exit 1
fi

./main
